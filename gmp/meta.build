DEFAULT_VERSION="6.3.0"
PACKAGE_TYPE="source"
LANGS="C,C++"

build-meta() {
  if [[ "${CXXPM_SYSTEM_NAME}" = "Windows" && "${CXXPM_SYSTEM_SUBTYPE}" = "msvc" ]]
  then
    echo "Can't build gmp with visual studio, use mpir instead"
    exit 1
  fi

  C_COMMAND="${CXXPM_COMPILER_C_COMMAND}"
  CXX_COMMAND="${CXXPM_COMPILER_CXX_COMMAND}"

  # gmp's configure is not C23 ('void g(){}' called with arguments): gnu17 for a compiler whose
  # default is newer, as gcc 15's is
  if printf '#if __STDC_VERSION__ > 201710L\nnewer\n#endif\n' | "${C_COMMAND}" -E -P -x c - 2>/dev/null | grep -q newer
  then
    C_COMMAND="${C_COMMAND} -std=gnu17"
  fi

  # Target flags go with the compiler: CFLAGS given to configure, even empty, replace the flags
  # gmp picks for the CPU and the ABI
  if [[ "${CXXPM_SYSTEM_NAME}" = "Darwin" && "${CXXPM_COMPILER_C_TYPE}" = "clang" ]]
  then
    C_COMMAND="${C_COMMAND} -arch ${CXXPM_CLANG_ARCH} -isysroot ${CXXPM_ISYSROOT}"
    CXX_COMMAND="${CXX_COMMAND} -arch ${CXXPM_CLANG_ARCH} -isysroot ${CXXPM_ISYSROOT}"
  fi

  # Appended to gmp's own flags: external C_FLAGS/CXX_FLAGS, after the build type's
  EXTRA_C_FLAGS="${C_FLAGS}"
  EXTRA_CXX_FLAGS="${CXX_FLAGS}"
  if [ "${CXXPM_BUILD_TYPE}" = "Debug" ]
  then
    EXTRA_C_FLAGS="-g -O0 ${EXTRA_C_FLAGS}"
    EXTRA_CXX_FLAGS="-g -O0 ${EXTRA_CXX_FLAGS}"
  fi

  CONFIGURE_ARGS=(
    --prefix=${CXXPM_INSTALL_DIR}
    --host=${CXXPM_AUTOTOOLS_HOST}
    --disable-static
    --enable-shared
    --enable-cxx
    "CC=${C_COMMAND}"
    "CXX=${CXX_COMMAND}"
  )

  cd ${CXXPM_BUILD_DIR}
  ${CXXPM_SOURCE_DIR}/gmp-${CXXPM_PACKAGE_VERSION}/configure "${CONFIGURE_ARGS[@]}"
  # configure has no way to append: run it again with its choice plus ours
  if [[ -n "${EXTRA_C_FLAGS// }${EXTRA_CXX_FLAGS// }" ]]
  then
    GMP_C_FLAGS=$(sed -n 's/^CFLAGS = //p' Makefile)
    GMP_CXX_FLAGS=$(sed -n 's/^CXXFLAGS = //p' Makefile)
    ${CXXPM_SOURCE_DIR}/gmp-${CXXPM_PACKAGE_VERSION}/configure "${CONFIGURE_ARGS[@]}" \
      "CFLAGS=${GMP_C_FLAGS} ${EXTRA_C_FLAGS}" \
      "CXXFLAGS=${GMP_CXX_FLAGS} ${EXTRA_CXX_FLAGS}"
  fi
  make -j${CXXPM_NPROC}
  make install
}

artifacts-meta() {
  GMP_DLL_SUFFIX="-10.dll"
  GMPXX_DLL_SUFFIX="-4.dll"
  IMPLIB_SUFFIX=".dll.a"

echo $(cat <<-END
  [
    {"type": "include", "name": "GMP_INCLUDE_DIRECTORY", "path": "include"},
    {
      "type": "shared_lib",
      "name": "gmp::libgmp",
      "path": "lib/${CXXPM_LIBRARY_PREFIX}gmp${CXXPM_SHARED_LIBRARY_SUFFIX}",
      "dll": "bin/${CXXPM_LIBRARY_PREFIX}gmp${GMP_DLL_SUFFIX}",
      "implib": "lib/${CXXPM_LIBRARY_PREFIX}gmp${IMPLIB_SUFFIX}",
      "includes": ["GMP_INCLUDE_DIRECTORY"]
    },
    {
      "type": "shared_lib",
      "name": "gmp::libgmpxx",
      "path": "lib/${CXXPM_LIBRARY_PREFIX}gmpxx${CXXPM_SHARED_LIBRARY_SUFFIX}",
      "dll": "bin/${CXXPM_LIBRARY_PREFIX}gmpxx${GMPXX_DLL_SUFFIX}",
      "implib": "lib/${CXXPM_LIBRARY_PREFIX}gmpxx${IMPLIB_SUFFIX}",
      "includes": ["GMP_INCLUDE_DIRECTORY"]
    }
  ]
END
)
}
