DEFAULT_VERSION="10.*"
PACKAGE_TYPE="source"
LANGS="C,C++"

build-meta() {
  eval "CMAKE_CONFIGURE_ARGS=${CXXPM_CMAKE_CONFIGURE_ARGS}"
  eval "CMAKE_BUILD_ARGS=${CXXPM_CMAKE_BUILD_ARGS}"
  eval "SEARCH_ARGS=${CXXPM_SEARCH_PATH_ARGS}"

  # install prefix of a dependency: dependency-prefix <package> <build type>
  dependency-prefix() {
    echo $(${CXXPM_EXECUTABLE} ${CXXPM_ARGS} "${SEARCH_ARGS[@]}" --build-type=$2 --search-path $1)/install
  }

  MSVC_PARALLEL_BUILD_FLAGS=""
  XPRESS_FLAGS=""
  if [ "${CXXPM_SYSTEM_SUBTYPE}" = "msvc" ]
  then
    INSTALL_ON_WINDOWS="-DROCKSDB_INSTALL_ON_WINDOWS=ON"
    MSVC_PARALLEL_BUILD_FLAGS="-DCMAKE_CXX_FLAGS_INIT=/MP"
    # xpress is the compression built into windows itself, no library needed
    XPRESS_FLAGS="-DWITH_XPRESS=ON"

    # msvc builds read all third party library paths from thirdparty.inc instead
    # of using find_package; it has no bzip2 section, add it
    cat ${CXXPM_PACKAGE_DIR}/thirdparty-bzip2.inc >> ${CXXPM_SOURCE_DIR}/rocksdb-${CXXPM_PACKAGE_VERSION}/thirdparty.inc

    # Get current, Debug and Release prefixes
    SNAPPY_INSTALL=$(dependency-prefix snappy ${CXXPM_BUILD_TYPE})
    SNAPPY_DEBUG_INSTALL=$(dependency-prefix snappy Debug)
    SNAPPY_RELEASE_INSTALL=$(dependency-prefix snappy Release)
    ZSTD_INSTALL=$(dependency-prefix zstd ${CXXPM_BUILD_TYPE})
    ZSTD_DEBUG_INSTALL=$(dependency-prefix zstd Debug)
    ZSTD_RELEASE_INSTALL=$(dependency-prefix zstd Release)
    LZ4_INSTALL=$(dependency-prefix lz4 ${CXXPM_BUILD_TYPE})
    LZ4_DEBUG_INSTALL=$(dependency-prefix lz4 Debug)
    LZ4_RELEASE_INSTALL=$(dependency-prefix lz4 Release)
    ZLIB_INSTALL=$(dependency-prefix zlib ${CXXPM_BUILD_TYPE})
    ZLIB_DEBUG_INSTALL=$(dependency-prefix zlib Debug)
    ZLIB_RELEASE_INSTALL=$(dependency-prefix zlib Release)
    BZIP2_INSTALL=$(dependency-prefix bzip2 ${CXXPM_BUILD_TYPE})
    BZIP2_DEBUG_INSTALL=$(dependency-prefix bzip2 Debug)
    BZIP2_RELEASE_INSTALL=$(dependency-prefix bzip2 Release)

    # thirdparty.inc reads paths from environment variables
    export SNAPPY_INCLUDE="${SNAPPY_INSTALL}/include"
    export SNAPPY_LIB_DEBUG="${SNAPPY_DEBUG_INSTALL}/lib/snappy.lib"
    export SNAPPY_LIB_RELEASE="${SNAPPY_RELEASE_INSTALL}/lib/snappy.lib"
    export ZSTD_INCLUDE="${ZSTD_INSTALL}/include"
    export ZSTD_LIB_DEBUG="${ZSTD_DEBUG_INSTALL}/lib/zstd_static.lib"
    export ZSTD_LIB_RELEASE="${ZSTD_RELEASE_INSTALL}/lib/zstd_static.lib"
    export LZ4_INCLUDE="${LZ4_INSTALL}/include"
    export LZ4_LIB_DEBUG="${LZ4_DEBUG_INSTALL}/lib/lz4.lib"
    export LZ4_LIB_RELEASE="${LZ4_RELEASE_INSTALL}/lib/lz4.lib"
    export ZLIB_INCLUDE="${ZLIB_INSTALL}/include"
    export ZLIB_LIB_DEBUG="${ZLIB_DEBUG_INSTALL}/lib/z.lib"
    export ZLIB_LIB_RELEASE="${ZLIB_RELEASE_INSTALL}/lib/z.lib"
    export BZIP2_INCLUDE="${BZIP2_INSTALL}/include"
    export BZIP2_LIB_DEBUG="${BZIP2_DEBUG_INSTALL}/lib/bz2.lib"
    export BZIP2_LIB_RELEASE="${BZIP2_RELEASE_INSTALL}/lib/bz2.lib"
  else
    INSTALL_ON_WINDOWS="-DROCKSDB_INSTALL_ON_WINDOWS=OFF"
    SNAPPY_INSTALL=$(dependency-prefix snappy ${CXXPM_BUILD_TYPE})
    ZSTD_INSTALL=$(dependency-prefix zstd ${CXXPM_BUILD_TYPE})
    LZ4_INSTALL=$(dependency-prefix lz4 ${CXXPM_BUILD_TYPE})
    ZLIB_INSTALL=$(dependency-prefix zlib ${CXXPM_BUILD_TYPE})
    BZIP2_INSTALL=$(dependency-prefix bzip2 ${CXXPM_BUILD_TYPE})
  fi

  cd ${CXXPM_SOURCE_DIR}/rocksdb-${CXXPM_PACKAGE_VERSION}
  for patch in ${PATCHES}; do
    patch -p1 < ${CXXPM_PACKAGE_DIR}/${patch}
  done

  cd ${CXXPM_BUILD_DIR}
  cmake \
    ${CXXPM_SOURCE_DIR}/rocksdb-${CXXPM_PACKAGE_VERSION} \
    -DCMAKE_INSTALL_PREFIX=${CXXPM_INSTALL_DIR} \
    -DCMAKE_PREFIX_PATH="${SNAPPY_INSTALL};${ZSTD_INSTALL};${LZ4_INSTALL};${ZLIB_INSTALL};${BZIP2_INSTALL}" \
    -DWITH_TESTS=OFF \
    -DWITH_GFLAGS=OFF \
    -DWITH_BENCHMARK_TOOLS=OFF \
    -DWITH_CORE_TOOLS=OFF \
    -DWITH_TOOLS=OFF \
    -DROCKSDB_BUILD_SHARED=OFF \
    -DWITH_SNAPPY=ON \
    -DWITH_ZSTD=ON \
    -DWITH_LZ4=ON \
    -DWITH_ZLIB=ON \
    -DWITH_BZ2=ON \
    -DPORTABLE=ON \
    -DFAIL_ON_WARNINGS=OFF \
    -DUSE_RTTI=OFF \
    "${INSTALL_ON_WINDOWS}" \
    ${XPRESS_FLAGS} \
    ${MSVC_PARALLEL_BUILD_FLAGS} \
    "${CMAKE_CONFIGURE_ARGS[@]}"

  cmake --build . ${CXXPM_CMAKE_BUILD_PARALLEL} --target install "${CMAKE_BUILD_ARGS[@]}"

  # Install PDB files for MSVC (avoids LNK4099 warnings when linking Debug builds)
  if [ "${CXXPM_SYSTEM_SUBTYPE}" = "msvc" ]; then
    cp ${CXXPM_BUILD_DIR}/${CXXPM_BUILD_TYPE}/rocksdb.pdb ${CXXPM_INSTALL_DIR}/lib/ 2>/dev/null || true
  fi
}

artifacts-meta() {
  # xpress compression links against the windows cabinet library
  XPRESS_SYSTEM_LIB=""
  if [ "${CXXPM_SYSTEM_SUBTYPE}" = "msvc" ]; then
    XPRESS_SYSTEM_LIB=', {"type": "system_lib", "name": "cabinet", "system_name": "Windows"}'
  fi

echo $(cat <<-END
  [
    {"type": "include", "name": "ROCKSDB_INCLUDE_DIRECTORY", "path": "include"},
    {"type": "static_lib", "name": "RocksDB::rocksdb", "path": "lib/${CXXPM_LIBRARY_PREFIX}rocksdb${CXXPM_STATIC_LIBRARY_SUFFIX}", "includes": ["ROCKSDB_INCLUDE_DIRECTORY"]${SYSTEM_LIBS}},
    {"type": "system_lib", "name": "rpcrt4", "system_name": "Windows"},
    {"type": "system_lib", "name": "shlwapi", "system_name": "Windows"}${XPRESS_SYSTEM_LIB}
  ]
END)
}
