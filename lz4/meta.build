DEFAULT_VERSION="1.10.0"
PACKAGE_TYPE="source"
LANGS="C"

build-meta() {
  eval "CMAKE_CONFIGURE_ARGS=${CXXPM_CMAKE_CONFIGURE_ARGS}"
  eval "CMAKE_BUILD_ARGS=${CXXPM_CMAKE_BUILD_ARGS}"

  MSVC_PARALLEL_BUILD_FLAGS=""
  if [ "${CXXPM_SYSTEM_SUBTYPE}" = "msvc" ]; then
    MSVC_PARALLEL_BUILD_FLAGS="-DCMAKE_C_FLAGS_INIT=/MP"
  fi

  cd ${CXXPM_BUILD_DIR}
  cmake \
    ${CXXPM_SOURCE_DIR}/lz4-${CXXPM_PACKAGE_VERSION}/build/cmake \
    -DCMAKE_INSTALL_PREFIX=${CXXPM_INSTALL_DIR} \
    -DBUILD_SHARED_LIBS=OFF \
    -DBUILD_STATIC_LIBS=ON \
    -DLZ4_BUILD_CLI=OFF \
    -DLZ4_BUILD_LEGACY_LZ4C=OFF \
    ${MSVC_PARALLEL_BUILD_FLAGS} \
    "${CMAKE_CONFIGURE_ARGS[@]}"

  cmake --build . ${CXXPM_CMAKE_BUILD_PARALLEL} --target install "${CMAKE_BUILD_ARGS[@]}"

  # Install PDB files for MSVC
  if [ "${CXXPM_SYSTEM_SUBTYPE}" = "msvc" ]; then
    cp ${CXXPM_BUILD_DIR}/${CXXPM_BUILD_TYPE}/lz4.pdb ${CXXPM_INSTALL_DIR}/lib/ 2>/dev/null || \
    cp ${CXXPM_BUILD_DIR}/${CXXPM_BUILD_TYPE}/lz4_static.pdb ${CXXPM_INSTALL_DIR}/lib/ 2>/dev/null || true
  fi
}

artifacts-meta() {
echo $(cat <<-END
  [
    {"type": "include", "name": "LZ4_INCLUDE_DIRECTORY", "path": "include"},
    {"type": "static_lib", "name": "LZ4::lz4", "path": "lib/${CXXPM_LIBRARY_PREFIX}lz4${CXXPM_STATIC_LIBRARY_SUFFIX}", "includes": ["LZ4_INCLUDE_DIRECTORY"]}
  ]
END)
}
