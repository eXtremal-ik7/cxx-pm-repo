source meta.build

TYPE="archive"
URL="https://github.com/openssl/openssl/releases/download/openssl-3.4.0/openssl-3.4.0.tar.gz"
SHA3="41fa85db97b3c82e078a3cd696f6e84b4a16f4fbe015cd8beeaed4fd41f32673"

USE='[
  {"name": "shared"}
]'

build() {
  build-meta
}

artifacts() {
  # OpenSSL 3.x installs 64-bit libraries into lib64 on Linux x86_64 and for the
  # mingw64 target (MinGW-w64 x86_64); everything else uses lib.
  if [ "${CXXPM_SYSTEM_PROCESSOR}" = "x86_64" ] && { [ "${CXXPM_SYSTEM_NAME}" = "Linux" ] || \
     { [ "${CXXPM_SYSTEM_NAME}" = "Windows" ] && [ "${CXXPM_SYSTEM_SUBTYPE}" = "mingw-w64" ]; }; }
  then
    OPENSSL_LIB_DIRECTORY="lib64"
  else
    OPENSSL_LIB_DIRECTORY="lib"
  fi

  artifacts-meta
}
